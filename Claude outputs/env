# HelpMeDraft — backend/.env (NE PAS COMMIT)

# ── Sécurité JWT ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=A_REMPLACER_par_python_-c_"import secrets; print(secrets.token_urlsafe(64))"

# ── Emailing (Flask-Mail) — sandbox Mailtrap en dev ───────────────────────────
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=A_REMPLACER_identifiant_mailtrap
MAIL_PASSWORD=A_REMPLACER_mot_de_passe_mailtrap
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=contact@helpmedraft.fr

# ── IA locale (Ollama) ────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
# Mode raisonnement désactivé. Sans effet sur qwen2.5, qui n'en a pas —
# et c'est précisément pourquoi ce modèle a été retenu : sur qwen3:4b, ni ce
# champ ni la consigne /no_think ne parvenaient à l'arrêter (mesuré sur
# Ollama 0.35.1 : 1 443 jetons et 2 minutes pour corriger une phrase de
# vingt caractères, contre 9 jetons et 0,27 s avec qwen2.5:3b).
OLLAMA_THINK=false
OLLAMA_CONNECT_TIMEOUT=10
IA_MAX_CONTENU_LENGTH=3000

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
