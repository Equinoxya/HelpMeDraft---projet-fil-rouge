# ==============================================================================
# HelpMeDraft — backend/.env.example
# ------------------------------------------------------------------------------
# Copier ce fichier en `.env` (à la racine de backend/) et renseigner de vraies
# valeurs. Le fichier `.env` réel ne doit JAMAIS être commit (déjà exclu par
# .gitignore).
# ==============================================================================

# ── Sécurité JWT ──────────────────────────────────────────────────────────────
# Clé utilisée pour signer les access tokens (auth_service.py).
# OBLIGATOIRE en dev comme en prod : config.py ne définit aucune valeur de
# repli et lève une RuntimeError au démarrage si cette variable est absente.
# Une clé en dur dans le dépôt rendrait les tokens falsifiables par quiconque
# lit le code source.
# Génère une valeur forte, par ex. : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Clé de session Flask, utilisée pour signer les cookies de session et les
# messages flash. OBLIGATOIRE au démarrage, comme JWT_SECRET_KEY.
# DOIT ÊTRE DIFFÉRENTE de JWT_SECRET_KEY : réutiliser une même clé pour deux
# usages cryptographiques distincts fait qu'une fuite sur l'un compromet
# l'autre (principe de séparation des clés).
# Génère une seconde valeur : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ── Conteneurisation (docker compose) ─────────────────────────────────────────
# Ces variables ne servent QUE si vous lancez la pile avec « docker compose up ».
# Un poste de développement classique peut les ignorer.

# ── Base MySQL de la pile ─────────────────────────────────────────────────────
#
# QUATRE mots de passe DISTINCTS, et tous OBLIGATOIRES : docker compose refuse
# de démarrer sans eux plutôt que d'inventer une valeur par défaut. Les générer
# un par un :
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Pourquoi quatre et pas un seul : la base applique le moindre privilège, avec
# trois comptes aux droits séparés (voir backend/database/droits_mysql.sql).
# Réutiliser un même mot de passe annulerait cette séparation — la fuite du
# compte applicatif donnerait aussi les droits de structure du compte de
# migration.
#
#   MYSQL_PASSWORD            helpmedraft_app        l'application. SELECT,
#                                                    INSERT, UPDATE, DELETE.
#                                                    Aucun droit de structure.
#   MYSQL_BACKUP_PASSWORD     helpmedraft_sauvegarde mysqldump. Lecture seule.
#   MYSQL_MIGRATION_PASSWORD  helpmedraft_migration  scripts de migration et
#                                                    restauration. Droits de
#                                                    structure, usage manuel.
#   MYSQL_ROOT_PASSWORD       root                   administration du SGBD.
#
# N'utiliser NI apostrophe NI antislash : le script d'initialisation des droits
# les refuse, parce qu'ils termineraient la chaîne SQL dans laquelle ils sont
# insérés.
#
# Le nom de la base n'est pas une variable : il est fixé à « helpmedraft » dans
# docker-compose.yml, parce que backend/database/schema_mysql.sql — la source
# de vérité du schéma — contient « USE helpmedraft ».
MYSQL_PASSWORD=
MYSQL_BACKUP_PASSWORD=
MYSQL_MIGRATION_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Ports publiés sur la machine hôte.
FRONTEND_PORT=8080
BACKEND_PORT=5000

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. En conteneur, le frontend est servi par nginx sur FRONTEND_PORT et
# non par Vite sur 5173 : sans cette valeur, le navigateur voit toutes ses
# requêtes refusées, sans aucune erreur côté serveur pour l'expliquer.
# Par défaut hors conteneur : http://localhost:5173
CORS_ORIGINS=http://localhost:8080

# URL du backend telle que le NAVIGATEUR la voit. Figée dans le bundle au
# moment de la construction de l'image : la changer impose de reconstruire le
# frontend, pas seulement de redémarrer le conteneur.
VITE_API_URL=http://localhost:5000/

# ── Environnement d'exécution ─────────────────────────────────────────────────
# "development" : cookie de refresh posé sans l'attribut Secure, pour que
# http://localhost fonctionne. TOUTE autre valeur ("production", "staging"...)
# active Secure : le cookie n'est alors transmis qu'en HTTPS.
APP_ENV=development

# ── Emailing (Flask-Mail) ──────────────────────────────────────────────────────
# En dev : sandbox Mailtrap. En prod : remplacé par Brevo (KAN-87, pas encore fait).
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=contact@helpmedraft.fr

# ── IA locale (Ollama) ──────────────────────────────────────────────────────────
# URL et modèle du serveur Ollama local utilisé par ia_service.py.
# Aucune clé API n'est nécessaire ici : l'inférence reste on-device (cf. RGPD).
OLLAMA_URL=http://localhost:11434

# ── Profils par machine ───────────────────────────────────────────────────────
# Les variables ci-dessous dépendent de la MACHINE qui exécute l'inférence,
# pas du projet. Reprendre le profil correspondant.
#
# Le MODÈLE, lui, ne change pas d'une machine à l'autre : qwen2.5:3b partout.
#
# NE PAS LE REMPLACER PAR UN MODÈLE À RAISONNEMENT (qwen3, deepseek-r1), même
# plus petit. Mesuré sur la même machine, pour corriger « BJR je serai en
# retar » :
#
#              jetons générés   débit        durée
#   qwen3:4b         1 443      11,9 j/s    2 min 01 s
#   qwen2.5:3b           9      38,5 j/s       0,27 s
#
# Un modèle à raisonnement produit un monologue d'analyse avant de répondre,
# de taille à peu près constante : il réfléchit autant pour une faute
# d'orthographe que pour trois pages. Sur Ollama 0.35.1, ni OLLAMA_THINK=false
# ni la consigne /no_think ne l'ont arrêté. Le facteur 440 ne vient pas du
# matériel mais du travail demandé.
#
#   Machine sans carte graphique, processeur modeste
#     À chaque jeton généré, le processeur relit tous les poids du modèle.
#     Compter 15 jetons/s : 3 000 caractères demandent environ 810 jetons de
#     sortie, soit à peu près 55 secondes d'attente annoncée.
#       IA_MAX_CONTENU_LENGTH=3000
#       VITE_IA_JETONS_PAR_SECONDE=15   (dans frontend/.env)
#
#   Machine courante, mesurée à 38 jetons/s sur qwen2.5:3b
#     C'est le profil de référence du projet. 3 000 caractères prennent une
#     vingtaine de secondes.
#       IA_MAX_CONTENU_LENGTH=3000
#       VITE_IA_JETONS_PAR_SECONDE=30   (dans frontend/.env)
#
#   Machine avec carte graphique de 6 Go
#     Le modèle tient entièrement en mémoire vidéo.
#       IA_MAX_CONTENU_LENGTH=8000
#       VITE_IA_JETONS_PAR_SECONDE=60   (dans frontend/.env)
#
# Vérifier le débit réel sur SA machine plutôt que de reprendre ces chiffres :
#     ollama run <modèle> --verbose "Reformule : bonjour je voulais savoir"
# et lire la ligne « eval rate ».

OLLAMA_MODEL=qwen2.5:3b

# Fenêtre de contexte, en jetons. À NE PAS LAISSER VIDE : sans cette valeur,
# Ollama tronque SILENCIEUSEMENT les prompts trop longs — sans erreur, et par
# l'avant, donc ce sont les consignes qui disparaissent avant le texte.
#
# MAIS NE PAS LA GONFLER « AU CAS OÙ ». Elle détermine la taille du cache
# d'attention alloué au chargement du modèle. Mesuré sur une machine dont la
# RAM est juste, même modèle et même prompt :
#
#   OLLAMA_NUM_CTX=4096   chargement   20,5 s
#   OLLAMA_NUM_CTX=8192   chargement  426,9 s
#
# Sept minutes pour une génération qui prend 0,2 seconde. Le besoin réel avec
# IA_MAX_CONTENU_LENGTH=3000 est d'environ 1 700 jetons (entrée + gabarit +
# sortie) : 4096 laisse une marge de 2,4. Relever cette valeur sans relever
# IA_MAX_CONTENU_LENGTH n'apporte donc rien.
OLLAMA_NUM_CTX=4096

# Durée pendant laquelle Ollama garde le modèle en mémoire après un appel.
#
# Son défaut est de 5 MINUTES, ce qui ne convient pas à un usage par
# intermittence : entre deux corrections espacées d'un quart d'heure, le
# modèle est déchargé et l'utilisateur repaie le chargement — qui représentait
# 426,9 s sur un appel mesuré à 427,66 s au total.
#
# Contrepartie à assumer : le modèle occupe la RAM pendant toute cette durée
# (environ 2 Gio pour qwen2.5:3b). Sur une machine très contrainte, réduire la
# valeur, ou "0" pour décharger immédiatement.
OLLAMA_KEEP_ALIVE=30m

# Mode « raisonnement » des modèles qui en ont un (qwen3, deepseek-r1...).
#
# LAISSER À false. C'est le réglage qui décide si l'IA est utilisable sur une
# machine sans carte graphique. Un modèle à raisonnement génère un bloc
# <think>...</think> avant sa réponse, et ce bloc a une taille à peu près
# CONSTANTE : il réfléchit autant pour corriger « BJR » que pour reformuler
# trois pages. Mesuré sur qwen3:4b, cela faisait plusieurs MINUTES d'attente
# pour corriger une phrase de quarante caractères.
#
# Ce mode n'apporte rien ici : reformuler, corriger et compléter sont des
# tâches de réécriture, pas de résolution de problème.
#
# Sans effet sur le modèle par défaut, qui n'a pas de mode raisonnement : le
# champ est conservé pour qui voudrait essayer un modèle qui en a un. Ollama
# rejette alors parfois le champ avec un 400 ; le service refait l'appel sans
# lui.
#
# NE PAS COMPTER SUR CE RÉGLAGE POUR RENDRE UN MODÈLE À RAISONNEMENT
# UTILISABLE. Mesuré sur Ollama 0.35.1 avec qwen3:4b, il n'a rien changé —
# pas plus que la consigne /no_think, depuis retirée du projet parce qu'elle
# était recopiée dans la réponse au lieu de désactiver quoi que ce soit. Le
# seul levier fiable est le choix du modèle.
OLLAMA_THINK=false

# Délai maximum pour ÉTABLIR la connexion à Ollama, en secondes.
#
# Il n'y a PAS de délai sur la lecture de la réponse, et c'est volontaire : une
# inférence sur processeur seul dépasse souvent la minute, et la couper
# affichait une erreur alors que la génération aboutissait. Le frontend annonce
# l'attente avec un compteur plutôt que de l'interrompre.
#
# Ce délai-ci reste court : si Ollama n'est pas lancé, l'échec doit être
# immédiat.
OLLAMA_CONNECT_TIMEOUT=10

# Taille maximale du texte soumis à l'IA, en caractères. Reformuler produit à
# peu près autant de texte qu'il en reçoit : cette borne ne protège plus d'un
# délai dépassé mais d'une attente déraisonnable. La garder cohérente avec le
# débit réel de la machine (voir les profils ci-dessus).
IA_MAX_CONTENU_LENGTH=3000

# ── Frontend ────────────────────────────────────────────────────────────────────
# Utilisé pour construire le lien de réinitialisation de mot de passe
# (auth_routes.py -> forgot_password). Doit pointer vers l'URL publique
# du frontend en production.
FRONTEND_URL=http://localhost:5173

# ── Estimation du temps de génération ─────────────────────────────────────────
# Le temps estimé affiché pendant la génération se règle côté frontend, pas
# ici : voir VITE_IA_JETONS_PAR_SECONDE dans frontend/.env.example. Vite
# n'expose au navigateur que les variables préfixées VITE_, qui doivent donc
# vivre dans son propre fichier.
